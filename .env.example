# ── Site URL ─────────────────────────────────────────────────
# Full URL of this instance (e.g. https://campus.rmtrack.uni.ac.uk)
SITE_URL=https://your-vm-hostname

# ── PostgreSQL ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# ── Supabase secrets ──────────────────────────────────────────
# JWT secret (at least 32 chars) — generate with: openssl rand -base64 32
JWT_SECRET=change-me

# Supabase API keys — JWTs signed with JWT_SECRET
# Use the generator at: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
ANON_KEY=<jwt-with-role-anon>
SERVICE_ROLE_KEY=<jwt-with-role-service_role>

# ── Express backend ───────────────────────────────────────────
# Separate JWT secret for the Express API (different from Supabase)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_EXPRESS=change-me-different
JWT_EXPIRES_IN=7d

# ── Supabase Studio login ─────────────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# ── Multi-team port offsets (only needed when running multiple instances) ──
# Default instance uses 8000 / 5555
# Second instance example: KONG_HTTP_PORT=8100  STUDIO_PORT=5655
